# ═══════════════════════════════════════════════════════════════════════════
# SocialConnect — Environment Variables
# Copy this file to `.env` and fill in your values (do NOT commit `.env`).
# ═══════════════════════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=your-super-secret-jwt-key-here
ADMIN_SECRET=Admin@2024
NODE_ENV=development

# ─── Supabase (live database) ────────────────────────────────────────────────
# Find these in Supabase Dashboard → Project Settings → API
# Project URL: https://<project-ref>.supabase.co
SUPABASE_URL=https://ppetpuukiffexqoxghnl.supabase.co
# Use the publishable key (sb_publishable_...) or the service_role key for full server access.
SUPABASE_ANON_KEY=your-publishable-or-service-role-key

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# ─── AI (optional) ───────────────────────────────────────────────────────────
# AI_API_KEY=your-ai-key

# ─── Reels (optional) ────────────────────────────────────────────────────────
# PIXABAY_API_KEY=your-pixabay-key
